<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BlueShell.View.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:BlueShell.Model.Settings"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:BlueShell.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
        <converters:AppBackgroundTypeToVisibilityConverter x:Key="AppBackgroundTypeToVisibilityConverter"/>
        <converters:AppBackgroundTypeToBoolConverter x:Key="AppBackgroundTypeToBoolConverter"/>
    </Page.Resources>

    <Grid>
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0"
                  Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0"
                          VerticalAlignment="Top"
                          VerticalContentAlignment="Top"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          IsExpanded="True">
                    <Expander.Header>
                        <TextBlock Text="Application Backdrop"
                               FontFamily="Cascadia Mono"
                               FontSize="16"/>
                    </Expander.Header>
                    <RadioButtons Margin="0, 25, 0, 0"
                                  MaxColumns="5">
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedBackdropCommand}"
                                     CommandParameter="{x:Bind model:AppBackdrop.MicaAlt}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedBackdrop, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=MicaAlt}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="Mica Alt"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedBackdropCommand}"
                                     CommandParameter="{x:Bind model:AppBackdrop.Mica}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedBackdrop, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Mica}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="Mica"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedBackdropCommand}"
                                     CommandParameter="{x:Bind model:AppBackdrop.ThinAcrylic}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedBackdrop, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=ThinAcrylic}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="Thin Acrylic"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedBackdropCommand}"
                                     CommandParameter="{x:Bind model:AppBackdrop.Acrylic}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedBackdrop, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Acrylic}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="Acrylic"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedBackdropCommand}"
                                     CommandParameter="{x:Bind model:AppBackdrop.None}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedBackdrop, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=None}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="None"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                    </RadioButtons>
                </Expander>

                <Expander Grid.Row="1"
                      VerticalAlignment="Top"
                      VerticalContentAlignment="Top"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      IsExpanded="True"
                      Margin="0, 15, 0, 0">
                    <Expander.Header>
                        <TextBlock Text="Application Theme"
                               FontFamily="Cascadia Mono"
                               FontSize="16"/>
                    </Expander.Header>
                    <RadioButtons Margin="0, 25, 0, 0"
                                  MaxColumns="3">
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedThemeCommand}"
                                     CommandParameter="{x:Bind model:AppTheme.Default}"
                                     Content="Default"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Default}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedThemeCommand}"
                                     CommandParameter="{x:Bind model:AppTheme.Dark}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Dark}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="Dark"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                        <RadioButton Command="{x:Bind _settingsViewModel.SetSelectedThemeCommand}"
                                     CommandParameter="{x:Bind model:AppTheme.Light}"
                                     IsChecked="{x:Bind _settingsViewModel.SelectedTheme, Mode=OneWay, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Light}"
                                     IsEnabled="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                     Content="Light"
                                     FontFamily="Cascadia Mono"
                                     FontSize="16"/>
                    </RadioButtons>
                </Expander>
            </Grid>
            <Expander Grid.Column="1"
                          VerticalAlignment="Top"
                          VerticalContentAlignment="Top"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          IsExpanded="True">
                <Expander.Header>
                    <TextBlock Text="Application Background"
                                   FontFamily="Cascadia Mono"
                                   FontSize="16"/>
                </Expander.Header>
                <Grid Margin="0, 0, 0, 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Row="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Top">
                        <RadioButtons MaxColumns="3">

                            <RadioButton Content="Image"
                                         FontFamily="Cascadia Mono"
                                         FontSize="14"
                                         IsChecked="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Image}"
                                         Command="{x:Bind _settingsViewModel.SetSelectedBackgroundTypeCommand}"
                                         CommandParameter="{x:Bind model:AppBackgroundType.Image}"/>

                            <RadioButton Content="Gradient"
                                         FontFamily="Cascadia Mono"
                                         FontSize="14"
                                         IsChecked="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Color}" 
                                         Command="{x:Bind _settingsViewModel.SetSelectedBackgroundTypeCommand}"
                                         CommandParameter="{x:Bind model:AppBackgroundType.Color}"/>

                            <RadioButton Content="Backdrop"
                                         FontFamily="Cascadia Mono"
                                         FontSize="14"
                                         IsChecked="{x:Bind _settingsViewModel.SelectedBackgroundType, Mode=OneWay, Converter={StaticResource AppBackgroundTypeToBoolConverter}, ConverterParameter=Backdrop}"
                                         Command="{x:Bind _settingsViewModel.SetSelectedBackgroundTypeCommand}"
                                         CommandParameter="{x:Bind model:AppBackgroundType.Backdrop}"/>

                        </RadioButtons>
                    </Grid>

                    <Grid Row="1">
                        <Grid Visibility="{x:Bind _settingsViewModel.SelectedBackgroundType,
                            Mode=OneWay,
                            Converter={StaticResource AppBackgroundTypeToVisibilityConverter},
                            ConverterParameter=Image}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                        Content="Browse..."
                                        Width="120"
                                        Height="35"
                                        FontFamily="Cascadia Mono"
                                        FontSize="14"
                                        Margin="0, 20, 0, 0"
                                        Command="{x:Bind _settingsViewModel.BrowseImageCommand}"/>
                            <CheckBox Grid.Column="1"
                                      Padding="10, 7, 0, 0"
                                      Content="Use desktop wallpaper"
                                      FontFamily="Cascadia Mono"
                                      FontSize="16"
                                      Margin="0, 18, 0, 0"
                                      IsChecked="{x:Bind _settingsViewModel.IsDesktopWallpaper, Mode=TwoWay}"/>
                        </Grid>
                        <Grid Visibility="{x:Bind _settingsViewModel.SelectedBackgroundType,
                                                  Mode=OneWay, Converter={StaticResource AppBackgroundTypeToVisibilityConverter},
                                                  ConverterParameter=Color}"
                              Margin="0, 20, 0, 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  IsHitTestVisible="True">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBox Header="First Color"
                                         FontFamily="Cascadia Mono"
                                         IsHitTestVisible="True"
                                         FontSize="14"
                                         Grid.Row="0"
                                         Width="150"
                                         GotFocus="FirstColorBox_GotFocus"
                                         Text="{x:Bind _settingsViewModel.Color1, Mode=TwoWay}">
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout Placement="Right">
                                            <ColorPicker x:Name="FirstColorPicker"
                                                         IsAlphaEnabled="False"
                                                         IsMoreButtonVisible="False"
                                                         IsColorSliderVisible="False"
                                                         IsHexInputVisible="False"
                                                         IsColorSpectrumVisible="True"
                                                         ColorChanged="FirstColorPicker_ColorChanged"/>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </TextBox>
                                <TextBox Header="Second Color"
                                         FontFamily="Cascadia Mono"
                                         FontSize="14"
                                         Grid.Row="1"
                                         Width="150"
                                         GotFocus="SecondColorBox_GotFocus"
                                         Margin="0, 10, 0, 0"
                                         Text="{x:Bind _settingsViewModel.Color2, Mode=TwoWay}">
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout Placement="Right">
                                            <ColorPicker x:Name="SecondColorPicker"
                                                         IsAlphaEnabled="False"
                                                         IsMoreButtonVisible="False"
                                                         IsColorSliderVisible="False"
                                                         IsHexInputVisible="False"
                                                         IsColorSpectrumVisible="True"
                                                         ColorChanged="SecondColorPicker_ColorChanged"/>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </TextBox>
                                <TextBox Header="Third Color"
                                         FontFamily="Cascadia Mono"
                                         FontSize="14"
                                         Grid.Row="2"
                                         Width="150"
                                         GotFocus="ThirdColorBox_GotFocus"
                                         Margin="0, 10, 0, 0"
                                         Text="{x:Bind _settingsViewModel.Color3, Mode=TwoWay}">
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout Placement="Right">
                                            <ColorPicker x:Name="ThirdColorPicker"
                                                         IsAlphaEnabled="False"
                                                         IsMoreButtonVisible="True"
                                                         IsColorSliderVisible="False"
                                                         IsHexInputVisible="False"
                                                         IsColorSpectrumVisible="True"
                                                         ColorChanged="ThirdColorPicker_ColorChanged"/>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                </TextBox>
                            </Grid>
                            <Grid Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Margin="20, 0, 0, 0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ComboBox Grid.Row="0"
                                          SelectedItem="{x:Bind _settingsViewModel.SelectedGradientDirection, Mode=TwoWay}"
                                          FontFamily="Cascadia Mono"
                                          FontSize="14"
                                          Margin="0, 26, 0, 0"
                                          ItemsSource="{x:Bind _settingsViewModel.GradientDirections}"/>
                                <Button Grid.Row="1"
                                        Content="Set Linear Gradient"
                                        Height="35"
                                        FontFamily="Cascadia Mono"
                                        FontSize="14"
                                        Margin="0, 33, 0, 0"
                                        Command="{x:Bind _settingsViewModel.SetLinearGradientCommand}"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Expander>
        </Grid>
    </Grid>
</Page>
