<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Name="TerminalUserControl"
    x:Class="BlueShell.View.UserControls.CanvasTerminal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueShell.View.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:graphicsControls="using:Microsoft.Graphics.Canvas.UI.Xaml"
    CharacterReceived="TerminalUserControl_CharacterReceived"
    KeyDown="TerminalUserControl_KeyDown"
    Loaded="TerminalUserControl_Loaded"
    Unloaded="TerminalUserControl_Unloaded"
    LostFocus="TerminalUserControl_LostFocus"
    PointerPressed="TerminalUserControl_PointerPressed"
    PointerWheelChanged="TerminalUserControl_PointerWheelChanged"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="TerminalScrollView"
                      VerticalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto">
            <graphicsControls:CanvasVirtualControl
            x:Name="Terminal"
            RegionsInvalidated="Terminal_RegionsInvalidated"/>
        </ScrollViewer>
    </Grid>
</UserControl>
